{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"color": {
			"palette": [
				{ "slug": "primary", "name": "Voltria Primary", "color": "#0A5BFF" },
				{ "slug": "navy", "name": "Voltria Navy", "color": "#0E2A4F" },
				{ "slug": "accent", "name": "Voltria Accent", "color": "#22C1DC" },
				{ "slug": "gray-bg", "name": "Gray Background", "color": "#F5F6FA" },
				{ "slug": "gray-text", "name": "Gray Text", "color": "#6B7280" },
				{ "slug": "white", "name": "White", "color": "#FFFFFF" }
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "inter",
					"name": "Inter (system)",
					"fontFamily": "Inter, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, 'Apple Color Emoji','Segoe UI Emoji'"
				}
			]
		}
	},
	"styles": {
		"typography": {
			"fontFamily": "var(--v-font)"
		},
		"color": {
			"background": "var(--v-white)",
			"text": "var(--v-gray-900)"
		}
	}
}
